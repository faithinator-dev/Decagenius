<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= agent.name %> - Decagenius</title>
    <link rel="stylesheet" href="/agent-page.css">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
    <div class="agent-container" data-agent-id="<%= agent.id %>">
        <header class="agent-header">
            <a href="/" class="back-link">&larr; All Agents</a>
            <div id="agent-emoji" class="agent-emoji"><%- agent.icon %></div>
            <h1 id="agent-name"><%= agent.name %></h1>
            <p id="agent-description" class="agent-description"><%= agent.description %></p>
        </header>

        <main class="chat-main">
            <div id="chat-window">
                <div id="chat-history"></div>
                <div class="input-area-container">
                    <div id="file-preview" class="file-preview"></div>
                    <div class="chat-input">
                        <% if (agent.fileUpload) { %>
                            <div id="file-upload-area" class="file-upload-area">
                                <label for="file-input" class="file-input-label" title="Attach a file">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
                                </label>
                                <input type="file" id="file-input" style="display: none;">
                            </div>
                        <% } %>
                        <textarea id="prompt-input" placeholder="Chat with the agent..."></textarea>
                        <button id="send-button" title="Send message">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script src="/agent-page.js"></script>
</body>
</html>